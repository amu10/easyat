  <name>easy-at-spring</name>
  <description>Spring integration for easy-at: AOP aspect, management endpoints and context propagation.</description>
  <url>https://github.com/amu10/easyat</url>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
